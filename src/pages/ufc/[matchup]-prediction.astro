---
// Matchup prediction page: /ufc/<fighterA>-vs-<fighterB>-prediction
//
// One page per fight on the next upcoming card. Head-to-head stats, the model's
// analysis (public), and the model pick (public for opening prelims, gated for
// the rest). Links back to the event page (event ↔ matchup internal linking).

import SeoLayout from '../../layouts/SeoLayout.astro';
import FightCard from '../../components/FightCard.astro';
import EmailGate from '../../components/EmailGate.astro';
import { getNextEvent } from '../../lib/data';
import { matchupSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { SITE, eventUrlFromSlug, matchupUrlFromSlug } from '../../lib/site';

export async function getStaticPaths() {
  const event = await getNextEvent();
  if (!event) return [];
  return event.fights.map((fight) => ({
    params: { matchup: fight.matchupSlug },
    props: { event, fight },
  }));
}

const { event, fight } = Astro.props;
const canonical = matchupUrlFromSlug(fight.matchupSlug);
const eventUrl = eventUrlFromSlug(event.slug);

const prettyDate = new Date(event.date + 'T00:00:00Z').toLocaleDateString(
  'en-US',
  { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }
);

const matchupName = `${fight.red.name} vs. ${fight.blue.name}`;
const title = `${matchupName} Prediction & Pick — ${event.name} | CombatCall`;
const description = `Data-driven prediction for ${matchupName} at ${event.name} (${prettyDate}). Head-to-head stats, model analysis, and the betting line. ${fight.weightClass || 'UFC'} bout.`;

// Single source of truth for the page FAQ (schema + visible markup).
const pickAvailability = fight.pickIsFree
  ? 'The pick is shown free on this page.'
  : 'Unlock the pick with a free email signup.';
const faqs = [
  {
    q: `Who wins ${matchupName}?`,
    a: `CombatCall's model produces a pick for ${matchupName} based on fighter history, matchup style, and the current market line. ${pickAvailability}`,
  },
  {
    q: `What's the betting line for ${matchupName}?`,
    a: `The current line and the model's read are shown on this page alongside the matchup stats and analysis. CombatCall is an analytics tool, not gambling advice.`,
  },
];

const schemas = [
  matchupSchema(event, fight),
  breadcrumbSchema([
    { name: 'CombatCall', url: SITE + '/' },
    { name: event.name, url: eventUrl },
    { name: matchupName, url: canonical },
  ]),
  faqSchema(faqs),
];
---

<SeoLayout {title} {description} {canonical} schemas={schemas}>
  <div class="wrap">
    <nav class="cc-crumbs" aria-label="Breadcrumb">
      <a href="/">CombatCall</a> › <a href={eventUrl}>{event.name}</a> › {matchupName}
    </nav>

    <h1>{matchupName}: Prediction &amp; Pick</h1>
    <p class="lede">
      <span class="serif">CombatCall</span>'s data-driven read on
      {matchupName} — {fight.weightClass || 'UFC'} bout at
      <a href={eventUrl}>{event.name}</a>, {prettyDate}. Full stats and analysis
      are free below.
    </p>

    <FightCard fight={fight} />

    {!fight.pickIsFree && <EmailGate source={`matchup_${fight.matchupSlug}`} />}

    <p style="margin-top:28px">
      ← Back to the full
      <a href={eventUrl}>{event.name} predictions</a>.
    </p>

    <section class="faq">
      <h2>FAQ</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>
  </div>
</SeoLayout>
