---
// Shared layout for the programmatic-SEO /ufc/ pages.
//
// Owns the SEO head (unique title/description/canonical/OG per page, JSON-LD
// schema slots), the brand styling (tokens match the hand-written homepage:
// #06070c bg, #f2c94c accent, Sora + Instrument Serif), the nav, the compliance
// footer (18+, not gambling advice, 1-800-GAMBLER — required on EVERY page), and
// PostHog init. Pages pass their meta + schema graph as props.
//
// Pages are fully static HTML (no client-only rendering) so they're crawlable.

import { OG_IMAGE } from '../lib/site';
import { serializeJsonLd } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  canonical: string; // absolute URL
  ogTitle?: string;
  ogDescription?: string;
  /** JSON-LD objects (SportsEvent, BreadcrumbList, FAQPage, …). */
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  schemas = [],
} = Astro.props;

const ogImage = OG_IMAGE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d14" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph + Twitter -->
    <meta property="og:title" content={ogTitle || title} />
    <meta property="og:description" content={ogDescription || description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="CombatCall" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || title} />
    <meta name="twitter:description" content={ogDescription || description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link rel="icon" type="image/png" href="/mark.png" />

    {
      schemas.map((s) => (
        <script
          type="application/ld+json"
          set:html={serializeJsonLd(s)}
        />
      ))
    }

    <style is:global>
      :root {
        --bg: #06070c;
        --bg-2: #0a0d14;
        --panel: #0d1019;
        --panel-2: #11141d;
        --panel-3: #161a25;
        --brand: #f2c94c;
        --brand-bright: #ffd966;
        --text: #f4f5f8;
        --muted: #9aa0ad;
        --muted-2: #6f7686;
        --border: rgba(242, 201, 76, 0.18);
        --border-soft: rgba(255, 255, 255, 0.07);
        --font-sans: 'Sora', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-serif: 'Instrument Serif', Georgia, serif;
        --maxw: 1060px;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a {
        color: var(--brand);
        text-decoration: none;
      }
      a:hover {
        color: var(--brand-bright);
        text-decoration: underline;
      }
      .wrap {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 0 22px;
      }

      /* header */
      header.cc-head {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(6, 7, 12, 0.85);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-soft);
      }
      .cc-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
      }
      .cc-nav .brand-logo {
        height: 26px;
        display: block;
      }
      .cc-nav .btn-brand {
        background: var(--brand);
        color: #06070c;
        font-weight: 700;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 14px;
      }
      .cc-nav .btn-brand:hover {
        background: var(--brand-bright);
        text-decoration: none;
      }

      /* breadcrumbs */
      .cc-crumbs {
        font-size: 13px;
        color: var(--muted-2);
        margin: 22px 0 8px;
      }
      .cc-crumbs a {
        color: var(--muted);
      }

      /* typography */
      h1 {
        font-size: clamp(28px, 4.5vw, 44px);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 6px 0 12px;
      }
      h2 {
        font-size: clamp(20px, 3vw, 27px);
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 38px 0 14px;
      }
      h3 {
        font-size: 18px;
        font-weight: 700;
      }
      p.lede {
        color: var(--muted);
        font-size: 17px;
        max-width: 64ch;
      }
      .serif {
        font-family: var(--font-serif);
        font-style: italic;
      }

      main {
        padding-bottom: 64px;
      }

      /* fight / matchup cards */
      .fight {
        background: var(--panel);
        border: 1px solid var(--border-soft);
        border-radius: 14px;
        padding: 20px 22px;
        margin: 16px 0;
      }
      .fight-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px 12px;
        justify-content: space-between;
      }
      .fight-title {
        font-size: 19px;
        font-weight: 700;
      }
      .fight-title a {
        color: var(--text);
      }
      .fight-meta {
        color: var(--muted-2);
        font-size: 13px;
      }
      .stat-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 6px 14px;
        margin: 16px 0;
        font-size: 14px;
      }
      .stat-grid .lbl {
        text-align: center;
        color: var(--muted-2);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .stat-grid .l {
        text-align: right;
      }
      .stat-grid .r {
        text-align: left;
      }
      .stat-grid .fname {
        font-weight: 600;
      }

      .analysis {
        margin: 12px 0;
      }
      .analysis ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 7px;
      }
      .analysis li {
        position: relative;
        padding-left: 18px;
        color: var(--text);
        font-size: 14.5px;
      }
      .analysis li::before {
        content: '';
        position: absolute;
        left: 2px;
        top: 9px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--brand);
      }

      .pick {
        margin-top: 14px;
        padding: 14px 16px;
        border-radius: 10px;
        background: var(--panel-2);
        border: 1px solid var(--border);
        position: relative;
      }
      .pick .pick-lbl {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand);
        font-weight: 700;
      }
      .pick .pick-bet {
        font-size: 16px;
        font-weight: 700;
        margin-top: 3px;
      }
      .pick .pick-line {
        color: var(--muted);
        font-size: 13px;
        margin-top: 2px;
      }
      .pick .pick-read {
        color: var(--muted-2);
        font-size: 13px;
        margin-top: 2px;
      }

      /* locked pick: server-rendered (crawlable) but obscured until unlock */
      .pick.locked .pick-body {
        filter: blur(7px);
        user-select: none;
        pointer-events: none;
        opacity: 0.7;
      }
      .pick.locked .pick-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--brand);
        background: rgba(13, 16, 25, 0.35);
        border-radius: 10px;
      }
      .cc-unlocked .pick.locked .pick-body {
        filter: none;
        user-select: auto;
        pointer-events: auto;
        opacity: 1;
      }
      .cc-unlocked .pick.locked .pick-overlay {
        display: none;
      }

      /* email gate */
      .cc-gate {
        margin: 36px 0;
        background: linear-gradient(180deg, var(--panel-2), var(--panel));
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px 24px;
        text-align: center;
      }
      .cc-unlocked .cc-gate {
        display: none;
      }
      .cc-gate-kicker {
        color: var(--brand);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
      }
      .cc-gate-title {
        font-size: 22px;
        font-weight: 800;
        margin: 6px 0 8px;
      }
      .cc-gate-sub {
        color: var(--muted);
        font-size: 15px;
        max-width: 52ch;
        margin: 0 auto 16px;
      }
      .cc-gate-form {
        display: flex;
        gap: 10px;
        max-width: 440px;
        margin: 0 auto;
        flex-wrap: wrap;
        justify-content: center;
      }
      .cc-gate-form input {
        flex: 1 1 220px;
        background: var(--bg-2);
        border: 1px solid var(--border-soft);
        color: var(--text);
        border-radius: 9px;
        padding: 12px 14px;
        font-size: 15px;
        font-family: inherit;
      }
      .cc-gate-form input:focus {
        outline: 2px solid var(--brand);
      }
      .cc-gate-form button {
        background: var(--brand);
        color: #06070c;
        font-weight: 700;
        border: 0;
        border-radius: 9px;
        padding: 12px 20px;
        font-size: 15px;
        cursor: pointer;
        font-family: inherit;
      }
      .cc-gate-form button:hover {
        background: var(--brand-bright);
      }
      .cc-gate-consent {
        color: var(--muted-2);
        font-size: 11.5px;
        margin-top: 14px;
        max-width: 50ch;
        margin-left: auto;
        margin-right: auto;
      }
      .cc-gate-err {
        color: #f5a3a3;
        font-size: 13px;
        margin-top: 10px;
      }

      /* faq */
      .faq details {
        border-bottom: 1px solid var(--border-soft);
        padding: 14px 0;
      }
      .faq summary {
        cursor: pointer;
        font-weight: 600;
        font-size: 16px;
        list-style: none;
      }
      .faq summary::-webkit-details-marker {
        display: none;
      }
      .faq p {
        color: var(--muted);
        font-size: 14.5px;
        margin-top: 8px;
      }

      /* footer */
      footer.cc-foot {
        border-top: 1px solid var(--border-soft);
        padding: 34px 0 46px;
        margin-top: 40px;
      }
      .cc-foot-top {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        justify-content: space-between;
      }
      .cc-foot-links {
        display: flex;
        gap: 18px;
        font-size: 14px;
      }
      .cc-foot-links a {
        color: var(--muted);
      }
      .cc-foot-meta {
        margin-top: 22px;
        color: var(--muted-2);
        font-size: 12.5px;
        line-height: 1.7;
      }
      .cc-foot-meta .disclaimer {
        color: var(--muted);
      }

      @media (max-width: 620px) {
        .stat-grid {
          font-size: 13px;
        }
      }
    </style>
  </head>
  <body>
    <header class="cc-head">
      <div class="wrap cc-nav">
        <a href="/" aria-label="CombatCall home">
          <img src="/logo.png" alt="CombatCall" class="brand-logo" />
        </a>
        <a class="btn-brand" href="https://app.combatcall.com" data-cta="seo-nav"
          >Sign Up Free</a
        >
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="cc-foot">
      <div class="wrap">
        <div class="cc-foot-top">
          <a href="/" aria-label="CombatCall home">
            <img src="/logo.png" alt="CombatCall" class="brand-logo" />
          </a>
          <div class="cc-foot-links">
            <a href="https://app.combatcall.com/terms">Terms</a>
            <a href="/privacy">Privacy</a>
            <a href="mailto:support@combatcall.com">Contact</a>
          </div>
        </div>
        <div class="cc-foot-meta">
          <div class="address">
            CMK Enterprises LLC · 9112 Gettysburg Drive, Huntington Beach, CA 92646
          </div>
          <div class="disclaimer">
            18+. Informational only — not gambling advice. CombatCall does not
            accept or facilitate wagers. Need help? Call 1-800-GAMBLER.
          </div>
          <div class="copyright">
            © 2026 CMK Enterprises LLC. All rights reserved.
          </div>
        </div>
      </div>
    </footer>

    <script>
      import {
        initAnalytics,
        initMetaPixel,
        forwardUtmsToAppLinks,
      } from '../lib/analyticsClient';
      initAnalytics();
      // Meta Pixel — fires standard PageView. No-op without PUBLIC_META_PIXEL_ID.
      initMetaPixel();
      // Carry the ad's UTMs onto every app.combatcall.com CTA so attribution
      // survives the cross-domain hop to the app.
      forwardUtmsToAppLinks();
    </script>
  </body>
</html>
